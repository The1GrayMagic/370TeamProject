<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<VBox prefHeight="400.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="habitPop.controller.LocationController" stylesheets="@css/base.css">
   <children>
      <TabPane styleClass="location-tabs" tabClosingPolicy="UNAVAILABLE" maxWidth="Infinity" maxHeight="Infinity">
         <tabs>
            <Tab text="High">
               <content>
                  <ScrollPane fitToWidth="true"
                              fitToHeight="false"
                              hbarPolicy="NEVER"
                              vbarPolicy="AS_NEEDED">
                     <content>
                        <VBox alignment="TOP_LEFT"
                              spacing="12.0"
                              styleClass="habit-list">
                           <children>
                              <CheckBox text="Habit 1" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 2" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 3" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 4" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 5" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 6" styleClass="habit-checkbox"/>
                           </children>
                           <padding>
                              <Insets top="15.0" right="10.0"
                                      bottom="10.0" left="15.0"/>
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </content>
            </Tab>
         </tabs>
      </TabPane>
      <TabPane styleClass="location-tabs" tabClosingPolicy="UNAVAILABLE" maxWidth="Infinity" maxHeight="Infinity">
         <tabs>
            <Tab text="Med">
               <content>
                  <ScrollPane fitToWidth="true"
                              fitToHeight="false"
                              hbarPolicy="NEVER"
                              vbarPolicy="AS_NEEDED">
                     <content>
                        <VBox alignment="TOP_LEFT"
                              spacing="12.0"
                              styleClass="habit-list">
                           <children>
                              <CheckBox text="Habit 1" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 2" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 3" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 4" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 5" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 6" styleClass="habit-checkbox"/>
                           </children>
                           <padding>
                              <Insets top="15.0" right="10.0"
                                      bottom="10.0" left="15.0"/>
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </content>
            </Tab>
         </tabs>
      </TabPane>
      <TabPane styleClass="location-tabs" tabClosingPolicy="UNAVAILABLE" maxWidth="Infinity" maxHeight="Infinity">
         <tabs>
            <Tab text="Low">
               <content>
                  <ScrollPane fitToWidth="true"
                              fitToHeight="false"
                              hbarPolicy="NEVER"
                              vbarPolicy="AS_NEEDED">
                     <content>
                        <VBox alignment="TOP_LEFT"
                              spacing="12.0"
                              styleClass="habit-list">
                           <children>
                              <CheckBox text="Habit 1" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 2" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 3" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 4" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 5" styleClass="habit-checkbox"/>
                              <CheckBox text="Habit 6" styleClass="habit-checkbox"/>
                           </children>
                           <padding>
                              <Insets top="15.0" right="10.0"
                                      bottom="10.0" left="15.0"/>
                           </padding>
                        </VBox>
                     </content>
                  </ScrollPane>
               </content>
            </Tab>
         </tabs>
      </TabPane>

   </children>
</VBox>
