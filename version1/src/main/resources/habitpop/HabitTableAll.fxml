<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="habitPop.controller.HabitALLTableController"
      prefHeight="400.0" prefWidth="600.0">

    <!-- Keep table at original size -->
    <TableView fx:id="habitTable"
               VBox.vgrow="ALWAYS"
               maxWidth="Infinity"
               maxHeight="Infinity">


            <columns>

                <TableColumn fx:id="nameColumn"  text="Name"/>
                <TableColumn fx:id="priorityColumn" text="Priority"/>
                <TableColumn fx:id="dateTimeColumn"  text="Date/Time"/>
                <TableColumn fx:id="completedColumn" text="Completed"/>

            </columns>


    </TableView>




    </VBox>
