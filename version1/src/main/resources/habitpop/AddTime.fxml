<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="20.0"
      prefWidth="400.0"
      prefHeight="230.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="habitPop.controller.AddTimeController"
      stylesheets="@css/base.css">

    <Label text="Add time" styleClass="form-heading"/>

    <HBox alignment="CENTER"
          spacing="8.0"
          styleClass="time-picker">

        <Spinner fx:id="hourSpinner"
                 editable="true"
                 prefWidth="75.0"
                 styleClass="time-spinner"/>

        <Label text=":"
               styleClass="time-separator"/>

        <Spinner fx:id="minuteSpinner"
                 editable="true"
                 prefWidth="75.0"
                 styleClass="time-spinner"/>

        <ComboBox fx:id="ampmCombo"
                  prefWidth="85.0"
                  styleClass="time-ampm"/>

    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="Cancel" onAction="#cancel"/>
        <Button text="Add time" defaultButton="true" onAction="#addTime"/>

    </HBox>

</VBox>