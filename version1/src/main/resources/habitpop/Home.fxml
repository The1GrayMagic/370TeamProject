<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox fx:id="homeRoot"
      prefHeight="950.0"
      prefWidth="1920.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="habitPop.controller.HomeController">

    <fx:define>
        <ToggleGroup fx:id="habitFilterGroup"/>
    </fx:define>

    <children>

        <!-- Top dashboard area -->
        <AnchorPane prefHeight="540.0"
                    prefWidth="1920.0">

            <children>

                <Text layoutX="14.0"
                      layoutY="42.0"
                      text="Welcome Back!">

                    <font>
                        <Font size="26.0"/>
                    </font>

                </Text>

                <Text layoutX="14.0"
                      layoutY="65.0"
                      text="Small steps make big progress. Keep it up!"/>


                <Button layoutX="1772.0"
                        layoutY="14.0"
                        prefHeight="47.0"
                        prefWidth="135.0"
                        text="+ New Habit"
                        onAction="#addHabit"/>


                <!-- Large weekly progress graph -->
                <GridPane fx:id="weeklyProgressGrid"
                          gridLinesVisible="true"
                          layoutX="0.0"
                          layoutY="146.0"
                          prefHeight="372.0"
                          prefWidth="1733.0">

                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES"
                                           prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES"
                                           prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES"
                                           prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES"
                                           prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES"
                                           prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES"
                                           prefWidth="100.0"/>
                        <ColumnConstraints hgrow="SOMETIMES"
                                           prefWidth="100.0"/>
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints vgrow="SOMETIMES"
                                        prefHeight="30.0"/>
                        <RowConstraints vgrow="SOMETIMES"
                                        prefHeight="30.0"/>
                        <RowConstraints vgrow="SOMETIMES"
                                        prefHeight="30.0"/>
                        <RowConstraints vgrow="SOMETIMES"
                                        prefHeight="30.0"/>
                        <RowConstraints vgrow="SOMETIMES"
                                        prefHeight="30.0"/>
                        <RowConstraints vgrow="SOMETIMES"
                                        prefHeight="30.0"/>
                        <RowConstraints vgrow="SOMETIMES"
                                        prefHeight="30.0"/>
                    </rowConstraints>

                </GridPane>


                <!-- Percentage completed circle -->
                <ProgressIndicator fx:id="completionProgress"
                                   layoutX="1826.0"
                                   layoutY="312.0"
                                   progress="0.30"
                                   scaleX="5.0"
                                   scaleY="5.0"/>

            </children>

        </AnchorPane>


        <!-- Filters -->
        <HBox spacing="8.0"
              prefHeight="35.0">

            <children>

                <ToggleButton text="Upcoming"
                              onAction="#showUpcoming">

                    <toggleGroup>
                        <fx:reference source="habitFilterGroup"/>
                    </toggleGroup>

                </ToggleButton>


                <ToggleButton text="All Habits"
                              selected="true"
                              onAction="#showAll">

                    <toggleGroup>
                        <fx:reference source="habitFilterGroup"/>
                    </toggleGroup>

                </ToggleButton>

            </children>

        </HBox>


        <!-- Keep table at original size -->
        <TableView fx:id="habitTable"
                   prefHeight="350.0"
                   minHeight="350.0"
                   maxHeight="350.0"
                   prefWidth="1920.0"
                   VBox.vgrow="NEVER">

            <columns>

                <TableColumn fx:id="nameColumn"
                             prefWidth="900.0"
                             text="Name"/>

                <TableColumn fx:id="dateTimeColumn"
                             prefWidth="700.0"
                             text="Date/Time"/>

                <TableColumn fx:id="completedColumn"
                             prefWidth="319.0"
                             text="Completed"/>

            </columns>

        </TableView>

    </children>

</VBox>