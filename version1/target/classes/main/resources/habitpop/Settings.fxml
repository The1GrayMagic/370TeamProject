<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="900.0"
      prefWidth="1400.0"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="habitPop.controller.SettingsController">

    <fx:define>
        <ToggleGroup fx:id="themeGroup"/>
        <ToggleGroup fx:id="timeFormatGroup"/>
        <ToggleGroup fx:id="weekStartGroup"/>
    </fx:define>

    <children>

        <!-- Page title -->
        <Text text="Settings">
            <font>
                <Font size="36.0"/>
            </font>
        </Text>

        <Text text="Customize HabitPop to fit your preferences."/>


        <!-- Appearance -->
        <Text text="Appearance">
            <font>
                <Font size="24.0"/>
            </font>
        </Text>

        <HBox spacing="10.0">

            <Label text="Theme:"/>

            <ToggleButton fx:id="lightThemeButton"
                          text="Light">

                <toggleGroup>
                    <fx:reference source="themeGroup"/>
                </toggleGroup>

            </ToggleButton>

            <ToggleButton fx:id="darkThemeButton"
                          text="Dark">

                <toggleGroup>
                    <fx:reference source="themeGroup"/>
                </toggleGroup>

            </ToggleButton>

            <ToggleButton fx:id="systemThemeButton"
                          text="System"
                          selected="true">

                <toggleGroup>
                    <fx:reference source="themeGroup"/>
                </toggleGroup>

            </ToggleButton>

        </HBox>

        <Separator/>


        <!-- Notifications -->
        <Text text="Notifications">
            <font>
                <Font size="24.0"/>
            </font>
        </Text>

        <CheckBox fx:id="enableNotificationsCheckBox"
                  text="Enable habit reminders"
                  selected="true"/>

        <CheckBox fx:id="notificationSoundCheckBox"
                  text="Play notification sound"
                  selected="true"/>

        <HBox spacing="10.0">

            <Label text="Default reminder time:"/>

            <ComboBox fx:id="defaultReminderTimeCombo"
                      prefWidth="150.0"
                      promptText="Select time"/>

        </HBox>

        <Separator/>


        <!-- Display -->
        <Text text="Display">
            <font>
                <Font size="24.0"/>
            </font>
        </Text>

        <CheckBox fx:id="showCompletedCheckBox"
                  text="Show completed habits"
                  selected="true"/>

        <CheckBox fx:id="showProgressGraphCheckBox"
                  text="Show progress graph"
                  selected="true"/>

        <HBox spacing="10.0">

            <Label text="Time format:"/>

            <ToggleButton fx:id="twelveHourButton"
                          text="12 Hour"
                          selected="true">

                <toggleGroup>
                    <fx:reference source="timeFormatGroup"/>
                </toggleGroup>

            </ToggleButton>

            <ToggleButton fx:id="twentyFourHourButton"
                          text="24 Hour">

                <toggleGroup>
                    <fx:reference source="timeFormatGroup"/>
                </toggleGroup>

            </ToggleButton>

        </HBox>


        <HBox spacing="10.0">

            <Label text="Week starts on:"/>

            <ToggleButton fx:id="sundayButton"
                          text="Sunday"
                          selected="true">

                <toggleGroup>
                    <fx:reference source="weekStartGroup"/>
                </toggleGroup>

            </ToggleButton>

            <ToggleButton fx:id="mondayButton"
                          text="Monday">

                <toggleGroup>
                    <fx:reference source="weekStartGroup"/>
                </toggleGroup>

            </ToggleButton>

        </HBox>

        <Separator/>


        <!-- Startup -->
        <Text text="Startup">
            <font>
                <Font size="24.0"/>
            </font>
        </Text>

        <HBox spacing="10.0">

            <Label text="Default page:"/>

            <ComboBox fx:id="defaultPageCombo"
                      prefWidth="180.0"
                      promptText="Home"/>

        </HBox>

        <Separator/>


        <!-- Data -->
        <Text text="Data">
            <font>
                <Font size="24.0"/>
            </font>
        </Text>

        <HBox spacing="10.0">

            <Button text="Export Data"
                    onAction="#exportData"/>

            <Button text="Import Data"
                    onAction="#importData"/>

            <Button text="Clear History"
                    onAction="#clearHistory"/>

        </HBox>


        <!-- Bottom -->
        <HBox spacing="10.0">

            <Button text="Save Settings"
                    defaultButton="true"
                    onAction="#saveSettings"/>

        </HBox>

    </children>

</VBox>