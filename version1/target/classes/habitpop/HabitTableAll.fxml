<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.control.skin.TabPaneSkin.TabContentRegion?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="habitPop.controller.HabitALLTableController"
      prefHeight="400.0" prefWidth="600.0">

    <!-- Keep table at original size -->
    <TableView fx:id="habitTable"
               prefHeight="350.0"
               minHeight="350.0"
               maxHeight="350.0"
               prefWidth="1920.0"
               VBox.vgrow="ALWAYS">
        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    hbarPolicy="NEVER">

            <columns>

                <TableColumn fx:id="nameColumn"  text="Name"/>
                <TableColumn fx:id="priority" text="Priority"/>

                <TableColumn fx:id="dateTimeColumn"  text="Date/Time"/>

                <TableColumn fx:id="completedColumn" text="Completed"/>
            </columns>
        
        <ScrollPane/>

    </TableView>




    </VBox>
