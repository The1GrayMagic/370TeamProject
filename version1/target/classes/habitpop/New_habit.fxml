<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>


<VBox styleClass="page-root"
      stylesheets="@css/base.css"
      prefHeight="935.0" prefWidth="1536.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="habitPop.controller.NewHabitController">

   <fx:define>
      <ToggleGroup fx:id="priorityGroup" />
   </fx:define>

   <children>
      <!-- Page heading -->
      <AnchorPane prefHeight="134.0" >
         <children>
            <Text layoutX="10.0" layoutY="70.0" text="Create a new habit" styleClass="page-title"/>
            <Text layoutY="100.0" text="Add a habit to your schedule" textAlignment="RIGHT" wrappingWidth="740.0" styleClass="page-subtitle"/>
         </children>
      </AnchorPane>

      <!-- Habit name -->
      <AnchorPane prefHeight="125.0" >
         <children>
            <Text layoutX="150.0" layoutY="40.0" text="Habit name *" textAlignment="RIGHT" wrappingWidth="337.0" styleClass="form-heading" />
            <TextField fx:id="habitNameField" layoutX="415.0" layoutY="105.0" prefHeight="25.0" prefWidth="370.0" promptText="e.g Drink water" styleClass="form-field"/>
            <!-- try layoutX="415.0"
                           layoutY="90.0"
                           prefWidth="500.0"
                           promptText="e.g. Drink water" -->
         </children>
      </AnchorPane>

      <!-- Time -->
      <AnchorPane prefHeight="125.0" >
         <children>
            <Text layoutX="150.0" layoutY="40.0" text="Time *" textAlignment="RIGHT" wrappingWidth="152" styleClass="form-heading"/>
            <HBox alignment="CENTER" layoutX="280.0" layoutY="41.0" prefHeight="55.0" prefWidth="683.0" spacing="20.0">
               <children>
                  <Label text="Hour:" styleClass="form-label"/>
                  <Spinner fx:id="defaultHour" editable="true" prefWidth="100"/>

                  <Label text="Minute:" styleClass="from-label"/>
                  <Spinner fx:id="minuteSpinner" editable="true" prefWidth="100"/>

                  <Label text="Time:" styleClass="from-label"/>
                  <ComboBox fx:id="defaultTime" prefWidth="100"/>
               </children>
            </HBox>
         </children>
      </AnchorPane>

      <!-- Location -->
      <AnchorPane prefHeight="103.0" >
         <children>
            <Text layoutX="150.0" layoutY="50.0" text="Location:" textAlignment="RIGHT" wrappingWidth="208.0" styleClass="form-heading"/>
            <TextField fx:id="locationField" layoutX="420.0" layoutY="60.0" prefHeight="25.0" prefWidth="370.0" promptText="e.g Kitchen" styleClass="form-field" />
            <!--try layoutX="420.0"
                           layoutY="40.0"
                           prefWidth="500.0"
                           promptText="e.g. Kitchen-->
         </children>
      </AnchorPane>

      <!-- Priority -->
      <AnchorPane prefHeight="215.0" >
         <children>
            <Text layoutX="200.0" layoutY="50.0" text="Priority:" textAlignment="RIGHT" wrappingWidth="168.0" styleClass="form-heading"/>

            <RadioButton fx:id="highPriority" layoutX="300.0" layoutY="65.0" prefHeight="38.0" prefWidth="130.0" text="High" styleClass="priority-radio">
               <toggleGroup>
                  <fx:reference source="priorityGroup"/>
               </toggleGroup>

            </RadioButton>

            <RadioButton fx:id="mediumPriority" layoutX="300.0" layoutY="115.0" prefHeight="38.0" prefWidth="178.0" text="Medium" styleClass="priority-radio" >
               <toggleGroup>
                  <fx:reference source="priorityGroup"/>
               </toggleGroup>
         </RadioButton>

            <RadioButton fx:id="lowPriority" layoutX="300.0" layoutY="165.0" prefHeight="38.0" prefWidth="130.0" text="Low" styleClass="priority-radio" selected="true" >
               <toggleGroup>
                  <fx:reference source="priorityGroup"/>
               </toggleGroup>
            </RadioButton>

         </children>
      </AnchorPane>

      <!-- Notes -->
      <AnchorPane prefHeight="103.0" >
         <children>
            <Text layoutX="190.0" layoutY="35.0" text="Notes (optional)" textAlignment="RIGHT" wrappingWidth="330.359375" styleClass="form-heading"/>
            <TextField fx:id="notesField" layoutX="420.0" layoutY="60.0" prefHeight="25.0" prefWidth="370.0" promptText="Add any extra details" styleClass="form-field" />
            <!--  layoutX="420.0"
                           layoutY="40.0"
                           prefWidth="500.0"
                           promptText="Add any extra details"
                           styleClass="form-field -->
         </children>
      </AnchorPane>

      <!-- Buttons -->
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0">
         <children>
            <Button cancelButton="true" onAction="#cancel" text="Cancel" textAlignment="CENTER" styleClass="seconday-button"/>
            <Button defaultButton="true" onAction="#addHabit" text="Add" styleClass="primary-button"/>
         </children>
      </HBox>
   </children>
</VBox>
